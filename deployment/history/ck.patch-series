From 80f4da5708e343b0b2e27ca3ec1ad3d638f38a65 Mon Sep 17 00:00:00 2001
From: Qoder <qoder@localhost>
Date: Tue, 3 Nov 2026 14:55:09 +0000
Subject: [PATCH 4/6] experiment: isolate BF16 stage1 HF K grouping in V3

---
 ...peline_xdlops_b_preshuffle_gufusion_v3.hpp | 48 ++++++++++++++++++-
 1 file changed, 47 insertions(+), 1 deletion(-)

diff --git a/include/ck/tensor_operation/gpu/block/blockwise_gemm_pipeline_xdlops_b_preshuffle_gufusion_v3.hpp b/include/ck/tensor_operation/gpu/block/blockwise_gemm_pipeline_xdlops_b_preshuffle_gufusion_v3.hpp
index ca5c8b3a0..60e864303 100644
--- a/include/ck/tensor_operation/gpu/block/blockwise_gemm_pipeline_xdlops_b_preshuffle_gufusion_v3.hpp
+++ b/include/ck/tensor_operation/gpu/block/blockwise_gemm_pipeline_xdlops_b_preshuffle_gufusion_v3.hpp
@@ -528,7 +528,12 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
         // BF16 V3 variant: independent up-projection MFMA chunks, FP64 merge.
         // Applies uniformly to every output register, with no target-coordinate logic.
         constexpr bool UpFp64Merge = is_same_v<ADataType, bhalf_t> &&
-                                     is_same_v<BDataType, bhalf_t>;
+                                     is_same_v<BDataType, bhalf_t>
+#ifndef CK_MELLUM_HF_KORDER
+                                     ;
+#else
+                                     && false;
+#endif
         auto up_fp64 = make_static_buffer<AddressSpaceEnum::Vgpr, double>(
             Number<CThreadBuffer::Size()>{});
         if constexpr(UpFp64Merge) up_fp64.Clear();
@@ -555,6 +560,35 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
 
         __builtin_amdgcn_sched_barrier(0);
 
+        // Experimental BF16 KPack=8, 16x16 MFMA source permutation.
+        // HF MI32 LDS reads: K[0:4,8:12], then K[4:8,12:16].
+        // CK packs K8 per lane: exchange register bit2 with KLane bit1.
+        auto hf_korder = [&](auto& vec) {
+#ifdef CK_MELLUM_HF_KORDER
+            if constexpr(is_same_v<ADataType, bhalf_t> && is_same_v<BDataType, bhalf_t> &&
+                         MPerXDL == 16 && NPerXDL == 16 && KPack == 8)
+            {
+                auto src = vec;
+                const unsigned lane = get_thread_local_1d_id() % 64;
+                static_for<0, 4, 1>{}([&](auto pair) {
+                    constexpr unsigned reg = decltype(pair)::value;
+
+                    // Select source register pair using the destination KLane high bit.
+                    const unsigned lane_pair = (lane >> 5) * 2;
+                    using pair_type = typename vector_type<ComputeDataType, 2>::type;
+                    unsigned lo = bit_cast<unsigned>(src.template AsType<pair_type>()[Number<reg % 2>{}]);
+                    unsigned hi = bit_cast<unsigned>(src.template AsType<pair_type>()[Number<reg % 2 + 2>{}]);
+
+                    const unsigned from = (lane & ~32u) | ((reg / 2) * 32u);
+                    const unsigned lp = __builtin_amdgcn_ds_bpermute(from * 4, lo);
+                    const unsigned hp = __builtin_amdgcn_ds_bpermute(from * 4, hi);
+                    vec.template AsType<pair_type>()(pair) =
+                        bit_cast<pair_type>(lane_pair ? hp : lp);
+                });
+            }
+#endif
+        };
+
         // main body
         if constexpr(HasMainLoop)
         {
@@ -605,6 +639,9 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
                                                     [Number<b_thread_desc_.CalculateOffset(
                                                         make_tuple(n0, I0, k0, ik))>{}];
                             });
+                    hf_korder(a_thread_vec);
+                    hf_korder(b_thread_vec);
+                    hf_korder(b_thread_vec_up);
 
                             using mfma_input_type =
                                 typename vector_type<ComputeDataType,
@@ -751,6 +788,9 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
                             b_thread_bufs_up[I0][Number<b_thread_desc_.CalculateOffset(
                                 make_tuple(n0, I0, k0, ik))>{}];
                     });
+                    hf_korder(a_thread_vec);
+                    hf_korder(b_thread_vec);
+                    hf_korder(b_thread_vec_up);
 
                     using mfma_input_type =
                         typename vector_type<ComputeDataType, xdlops_gemm.K1PerXdlops>::type;
@@ -853,6 +893,9 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
                             b_thread_bufs_up[I1][Number<b_thread_desc_.CalculateOffset(
                                 make_tuple(n0, I0, k0, ik))>{}];
                     });
+                    hf_korder(a_thread_vec);
+                    hf_korder(b_thread_vec);
+                    hf_korder(b_thread_vec_up);
 
                     using mfma_input_type =
                         typename vector_type<ComputeDataType, xdlops_gemm.K1PerXdlops>::type;
@@ -918,6 +961,9 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
                             b_thread_bufs_up[I0][Number<b_thread_desc_.CalculateOffset(
                                 make_tuple(n0, I0, k0, ik))>{}];
                     });
+                    hf_korder(a_thread_vec);
+                    hf_korder(b_thread_vec);
+                    hf_korder(b_thread_vec_up);
 
                     using mfma_input_type =
                         typename vector_type<ComputeDataType, xdlops_gemm.K1PerXdlops>::type;
-- 
2.43.0


From 2a17cee0cf2d2f3c9d46de5fab265cf5aecd1ee7 Mon Sep 17 00:00:00 2001
