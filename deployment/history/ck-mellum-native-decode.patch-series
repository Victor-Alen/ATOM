From 756cb8723b7b02ed05a93150a51f59b0ea4937d1 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Wed, 4 Nov 2026 16:40:29 +0000
Subject: [PATCH 07/12] fix: match HF LSU4 prefill accumulation and tail K
 grouping

---
 MELLUM_PREFILL_LSU4_EXPERIMENT.md             |  22 ++++
 ...peline_xdlops_b_preshuffle_gufusion_v3.hpp | 102 +++++++++++-------
 .../gpu/grid/gridwise_moe_gemm.hpp            |   8 +-
 3 files changed, 90 insertions(+), 42 deletions(-)
 create mode 100644 MELLUM_PREFILL_LSU4_EXPERIMENT.md

diff --git a/MELLUM_PREFILL_LSU4_EXPERIMENT.md b/MELLUM_PREFILL_LSU4_EXPERIMENT.md
new file mode 100644
index 000000000..afd8da475
--- /dev/null
+++ b/MELLUM_PREFILL_LSU4_EXPERIMENT.md
@@ -0,0 +1,22 @@
+# Mellum BF16 prefill LSU4 experiment
+
+Opt-in stage1 profile 2 (CK_MELLUM_STAGE1_MODE bit 0x200) extends the original
+CK V3 preshuffled gate/up pipeline. Validated scope: HF MT32x16x512, LocalSplitU=4,
+K=2304, N=896, 8 routed experts, expert row count <=16 with no stagger rotation.
+Only the 256x64x128x64 stage1 instance was rebuilt in the isolated JIT directory.
+
+Keep four FP32 accumulator chains for depth512 chunks, assigning each consecutive
+128 K elements to its corresponding local split. Merge parts sequentially 0,1,2,3.
+The main K8 packing already matches HF. Its final K256 tail uses contiguous K4
+lane groups. For CK's KPack8, tail source K bits are (dest bit2 -> source bit4,
+dest bit3 -> source bit2, dest bit4 -> source bit3). This composes the probe's
+KPack1 layout with CK's KPack8 layout; copying the probe permutation directly is wrong.
+
+The fixed production-input replay covers 15 experts and 93,184 gate/up BF16
+outputs, all exact versus HF; the same kernel without this profile has 32 differing
+outputs. Evidence: /workspace/logs/step0_operator_parallel_20261104/
+ck_prefill_lsu4_expanded_probe.json and ck_prefill_lsu4_probe_v4.log.
+
+This is not enabled in the production model. Other HF dispatch classes, row-tile
+staggering, stage2, integration, performance and full-model gates remain pending.
+Accepted decode uses a separate, unchanged binary and does not use bit 0x200.
diff --git a/include/ck/tensor_operation/gpu/block/blockwise_gemm_pipeline_xdlops_b_preshuffle_gufusion_v3.hpp b/include/ck/tensor_operation/gpu/block/blockwise_gemm_pipeline_xdlops_b_preshuffle_gufusion_v3.hpp
index ffa4e9a42..ae88e6e9a 100644
--- a/include/ck/tensor_operation/gpu/block/blockwise_gemm_pipeline_xdlops_b_preshuffle_gufusion_v3.hpp
+++ b/include/ck/tensor_operation/gpu/block/blockwise_gemm_pipeline_xdlops_b_preshuffle_gufusion_v3.hpp
@@ -469,7 +469,7 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
                         const BBlockTransferStep& b_block_copy_step,
                         CThreadBuffer& c_thread_buf,
                         CThreadBuffer& c_thread_buf_up,
-                        index_t num_loop, bool hf_mi32 = false) const
+                        index_t num_loop, index_t hf_profile = 0) const
     {
         ignore = b_block_buf;
         __builtin_amdgcn_sched_barrier(0);
@@ -560,6 +560,13 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
 
         __builtin_amdgcn_sched_barrier(0);
 
+        const bool hf_mi32 = hf_profile == 1;
+        index_t hf_mfma_calls = 0;
+        StaticallyIndexedArray<CThreadBuffer, Number<4>{}> hf_gate_parts;
+        StaticallyIndexedArray<CThreadBuffer, Number<4>{}> hf_up_parts;
+        if(hf_profile == 2) static_for<0, 4, 1>{}([&](auto part) {
+            hf_gate_parts(part).Clear(); hf_up_parts(part).Clear();
+        });
         // Experimental BF16 KPack=8, 16x16 MFMA source permutation.
         // HF MI32 LDS reads: K[0:4,8:12], then K[4:8,12:16].
         // CK packs K8 per lane: exchange register bit2 with KLane bit1.
@@ -568,6 +575,26 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
             if constexpr(is_same_v<ADataType, bhalf_t> && is_same_v<BDataType, bhalf_t> &&
                          MPerXDL == 16 && NPerXDL == 16 && KPack == 8)
             {
+                if(hf_profile == 2) {
+                    const index_t block = hf_mfma_calls / (MRepeat * KRepeat * NRepeat);
+                    // HF depth512/LSU4 has a 256-element tail at K=2048.
+                    // Main LDS groups K[0:4,8:12,16:20,24:28]; tail is contiguous.
+                    if(block * KPerBlock >= 2048) {
+                        auto src = vec;
+                        const unsigned lane = get_thread_local_1d_id() % 64;
+                        static_for<0, 4, 1>{}([&](auto pair) {
+                            constexpr unsigned reg = decltype(pair)::value;
+                            using pair_type = typename vector_type<ComputeDataType, 2>::type;
+                            unsigned lo = bit_cast<unsigned>(src.template AsType<pair_type>()[Number<reg % 2>{}]);
+                            unsigned hi = bit_cast<unsigned>(src.template AsType<pair_type>()[Number<reg % 2 + 2>{}]);
+                            const unsigned from = (lane & 15u) | (((lane >> 5) & 1u) * 16u) | ((reg / 2) * 32u);
+                            const unsigned lp = __builtin_amdgcn_ds_bpermute(from * 4, lo);
+                            const unsigned hp = __builtin_amdgcn_ds_bpermute(from * 4, hi);
+                            vec.template AsType<pair_type>()(pair) = bit_cast<pair_type>((lane & 16u) ? hp : lp);
+                        });
+                    }
+                    return;
+                }
                 if(!hf_mi32) return;
                 auto src = vec;
                 const unsigned lane = get_thread_local_1d_id() % 64;
@@ -590,6 +617,26 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
 #endif
         };
 
+        auto hf_run = [&](auto& av, auto& bv, auto& uv, auto offset) {
+            using input_type = typename vector_type<ComputeDataType, xdlops_gemm.K1PerXdlops>::type;
+            if(hf_profile == 2) {
+                const index_t block = hf_mfma_calls / (MRepeat * KRepeat * NRepeat);
+                const index_t selected = ((block * KPerBlock) / 128) % 4;
+                static_for<0, 4, 1>{}([&](auto part) {
+                    if(selected == part.value) {
+                        xdlops_gemm.Run(av.template AsType<input_type>(), bv.template AsType<input_type>(), hf_gate_parts(part).GetVectorTypeReference(offset));
+                        xdlops_gemm.Run(av.template AsType<input_type>(), uv.template AsType<input_type>(), hf_up_parts(part).GetVectorTypeReference(offset));
+                    }
+                });
+            } else {
+                xdlops_gemm.Run(av.template AsType<input_type>(), bv.template AsType<input_type>(), c_thread_buf.GetVectorTypeReference(offset));
+                begin_up_chunk(offset);
+                xdlops_gemm.Run(av.template AsType<input_type>(), uv.template AsType<input_type>(), c_thread_buf_up.GetVectorTypeReference(offset));
+                merge_up_chunk(offset);
+            }
+            ++hf_mfma_calls;
+        };
+
         // main body
         if constexpr(HasMainLoop)
         {
@@ -651,17 +698,7 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
                             constexpr index_t c_offset =
                                 c_thread_desc_.CalculateOffset(make_tuple(m0, n0, 0));
 
-                            xdlops_gemm.Run(
-                                a_thread_vec.template AsType<mfma_input_type>(),
-                                b_thread_vec.template AsType<mfma_input_type>(),
-                                c_thread_buf.GetVectorTypeReference(Number<c_offset>{}));
-                            begin_up_chunk(Number<c_offset>{});
-
-                            xdlops_gemm.Run(
-                                a_thread_vec.template AsType<mfma_input_type>(),
-                                b_thread_vec_up.template AsType<mfma_input_type>(),
-                                c_thread_buf_up.GetVectorTypeReference(Number<c_offset>{}));
-                            merge_up_chunk(Number<c_offset>{});
+                            hf_run(a_thread_vec, b_thread_vec, b_thread_vec_up, Number<c_offset>{});
                         });
 
                         if constexpr(m0.value == MRepeat - 2)
@@ -799,15 +836,7 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
                     constexpr index_t c_offset =
                         c_thread_desc_.CalculateOffset(make_tuple(m0, n0, 0));
 
-                    xdlops_gemm.Run(a_thread_vec.template AsType<mfma_input_type>(),
-                                    b_thread_vec.template AsType<mfma_input_type>(),
-                                    c_thread_buf.GetVectorTypeReference(Number<c_offset>{}));
-                            begin_up_chunk(Number<c_offset>{});
-
-                    xdlops_gemm.Run(a_thread_vec.template AsType<mfma_input_type>(),
-                                    b_thread_vec_up.template AsType<mfma_input_type>(),
-                                    c_thread_buf_up.GetVectorTypeReference(Number<c_offset>{}));
-                            merge_up_chunk(Number<c_offset>{});
+                    hf_run(a_thread_vec, b_thread_vec, b_thread_vec_up, Number<c_offset>{});
                 });
                 if constexpr(m0.value == (MRepeat - 2))
                 {
@@ -904,15 +933,7 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
                     constexpr index_t c_offset =
                         c_thread_desc_.CalculateOffset(make_tuple(m0, n0, 0));
 
-                    xdlops_gemm.Run(a_thread_vec.template AsType<mfma_input_type>(),
-                                    b_thread_vec.template AsType<mfma_input_type>(),
-                                    c_thread_buf.GetVectorTypeReference(Number<c_offset>{}));
-                            begin_up_chunk(Number<c_offset>{});
-
-                    xdlops_gemm.Run(a_thread_vec.template AsType<mfma_input_type>(),
-                                    b_thread_vec_up.template AsType<mfma_input_type>(),
-                                    c_thread_buf_up.GetVectorTypeReference(Number<c_offset>{}));
-                            merge_up_chunk(Number<c_offset>{});
+                    hf_run(a_thread_vec, b_thread_vec, b_thread_vec_up, Number<c_offset>{});
                 });
 
                 if constexpr(m0.value < (MRepeat - 2))
@@ -972,14 +993,7 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
                     constexpr index_t c_offset =
                         c_thread_desc_.CalculateOffset(make_tuple(m0, n0, 0));
 
-                    xdlops_gemm.Run(a_thread_vec.template AsType<mfma_input_type>(),
-                                    b_thread_vec.template AsType<mfma_input_type>(),
-                                    c_thread_buf.GetVectorTypeReference(Number<c_offset>{}));
-                            begin_up_chunk(Number<c_offset>{});
-                    xdlops_gemm.Run(a_thread_vec.template AsType<mfma_input_type>(),
-                                    b_thread_vec_up.template AsType<mfma_input_type>(),
-                                    c_thread_buf_up.GetVectorTypeReference(Number<c_offset>{}));
-                            merge_up_chunk(Number<c_offset>{});
+                    hf_run(a_thread_vec, b_thread_vec, b_thread_vec_up, Number<c_offset>{});
                 });
 
                 if constexpr(m0.value < (MRepeat - 2))
@@ -1000,6 +1014,18 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
                 }
             });
         }
+        auto hf_add = [](float a, float b) { float v; asm volatile("v_add_f32 %0, %1, %2" : "=v"(v) : "v"(a), "v"(b)); return v; };
+        if(hf_profile == 2) {
+            static_for<0, CThreadBuffer::Size(), 1>{}([&](auto reg) {
+                float gate = hf_gate_parts[Number<0>{}][reg];
+                float up = hf_up_parts[Number<0>{}][reg];
+                static_for<1, 4, 1>{}([&](auto part) {
+                    gate = hf_add(gate, hf_gate_parts[part][reg]);
+                    up = hf_add(up, hf_up_parts[part][reg]);
+                });
+                c_thread_buf(reg) = gate; c_thread_buf_up(reg) = up;
+            });
+        }
     }
 
     protected:
