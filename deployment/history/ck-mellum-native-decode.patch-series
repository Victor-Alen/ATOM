@@ -581,11 +581,12 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
 
         __builtin_amdgcn_sched_barrier(0);
 
-        const bool hf_mi32 = hf_profile == 1 || hf_profile == 4;
+        const bool hf_mi32 = hf_profile == 1 || hf_profile == 4 || hf_profile == 9 || hf_profile == 10;
+        const bool hf_split = hf_profile == 2 || hf_profile == 3 || hf_profile >= 10;
         index_t hf_mfma_calls = 0;
         StaticallyIndexedArray<CThreadBuffer, Number<4>{}> hf_gate_parts;
         StaticallyIndexedArray<CThreadBuffer, Number<4>{}> hf_up_parts;
-        if(hf_profile == 2 || hf_profile == 3) static_for<0, 4, 1>{}([&](auto part) {
+        if(hf_split) static_for<0, 4, 1>{}([&](auto part) {
             hf_gate_parts(part).Clear(); hf_up_parts(part).Clear();
         });
         // Experimental BF16 KPack=8, 16x16 MFMA source permutation.
@@ -596,7 +597,7 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
             if constexpr(is_same_v<ADataType, bhalf_t> && is_same_v<BDataType, bhalf_t> &&
                          MPerXDL == 16 && NPerXDL == 16 && KPack == 8)
             {
-                if(hf_profile == 2 || hf_profile == 3) {
+                if(hf_split && !hf_mi32) {
                     const index_t block = hf_mfma_calls / (MRepeat * KRepeat * NRepeat);
                     // HF depth512/LSU4 has a 256-element tail at K=2048.
                     // Main LDS groups K[0:4,8:12,16:20,24:28]; tail is contiguous.
@@ -640,9 +641,9 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
 
