+            if(hf_split) {
                 const index_t block = hf_mfma_calls / (MRepeat * KRepeat * NRepeat);
-                const index_t selected = ((block * KPerBlock) / 128) % (hf_profile == 3 ? 2 : 4);
+                const index_t selected = ((block * KPerBlock) / (hf_profile == 12 ? 64 : 128)) % (hf_profile == 2 ? 4 : 2);
                 static_for<0, 4, 1>{}([&](auto part) {
                     if(selected == part.value) {
                         xdlops_gemm.Run(av.template AsType<input_type>(), bv.template AsType<input_type>(), hf_gate_parts(part).GetVectorTypeReference(offset));
@@ -1036,7 +1037,7 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
             });
         }
         auto hf_add = [](float a, float b) { float v; asm volatile("v_add_f32 %0, %1, %2" : "=v"(v) : "v"(a), "v"(b)); return v; };
-        if(hf_profile == 2 || hf_profile == 3) {
+        if(hf_split) {
             static_for<0, CThreadBuffer::Size(), 1>{}([&](auto reg) {
                 float gate = hf_gate_parts[Number<0>{}][reg];
                 float up = hf_up_parts[Number<0>{}][reg];
diff --git a/include/ck/tensor_operation/gpu/grid/gridwise_moe_gemm.hpp b/include/ck/tensor_operation/gpu/grid/gridwise_moe_gemm.hpp
index 1f337d3a9..363e3199e 100644
--- a/include/ck/tensor_operation/gpu/grid/gridwise_moe_gemm.hpp
+++ b/include/ck/tensor_operation/gpu/grid/gridwise_moe_gemm.hpp
@@ -1332,6 +1332,30 @@ struct GridwiseMoeGemm : public GridwiseGemm_xdl_cshuffle_base<
                                   true>
             c_thread_buf_fp32;
 
+        index_t hf_profile_for_block = 0;
+#ifdef CK_MELLUM_HF_KORDER
+        if constexpr(IsInputGemm) {
+            if((problem.MellumStage1Mode & 0x200) != 0) hf_profile_for_block = 2;
+            else if((problem.MellumStage1Mode & 0x100) != 0) {
+                const index_t kind = p_max_token_id[2 + expert_id];
+                index_t tile = 1, logical_rows = MPerBlock, depth_blocks = 0;
+                switch(kind) {
+                    case 4: tile=128; depth_blocks=1; break;
+                    case 5: tile=192; depth_blocks=1; break;
+                    case 6: tile=128; depth_blocks=2; break;
+                    case 7: tile=64; depth_blocks=2; break;
+                    case 8: tile=96; logical_rows=48; depth_blocks=2; break;
+                    case 9: tile=32; logical_rows=32; depth_blocks=2; break;
+                    case 10: tile=32; logical_rows=32; depth_blocks=4; break;
+                    case 11: tile=48; logical_rows=48; depth_blocks=4; break;
+                    case 12: tile=96; logical_rows=48; depth_blocks=2; break;
+                }
+                index_t rotation = 0;
+                if(depth_blocks != 0) rotation = (((block_m_id - p_max_token_id[66 + expert_id]) * logical_rows / tile) % 16) * depth_blocks;
+                hf_profile_for_block = kind | (rotation << 8);
+            }
+        }
+#endif
         const index_t num_k_block_main_loop = __builtin_amdgcn_readfirstlane(
             (a_grid_desc_ak0_m_ak1.GetLength(I0) * a_grid_desc_ak0_m_ak1.GetLength(I2)) /
             KPerBlock);
@@ -1374,12 +1398,7 @@ struct GridwiseMoeGemm : public GridwiseGemm_xdl_cshuffle_base<
                 c_thread_buf_up,
                 num_k_block_main_loop
 #ifdef CK_MELLUM_HF_KORDER
-                , ((problem.MellumStage1Mode & 0x200) != 0 ? 2 :
-                   ((problem.MellumStage1Mode & 0x100) != 0 ?
-                    (p_max_token_id[2 + expert_id] |
-                     ((p_max_token_id[2 + expert_id] == 4 || p_max_token_id[2 + expert_id] == 5) ?
-                       ((((block_m_id - p_max_token_id[66 + expert_id]) * MPerBlock /
-                          (p_max_token_id[2 + expert_id] == 4 ? 128 : 192)) % 16) << 8) : 0)) : 0))
+                , hf_profile_for_block
 #endif
                 );
         }
@@ -1852,6 +1871,30 @@ struct GridwiseMoeGemm : public GridwiseGemm_xdl_cshuffle_base<
                                   true>
             c_thread_buf_fp32;
 
+        index_t hf_profile_for_block = 0;
+#ifdef CK_MELLUM_HF_KORDER
+        if constexpr(IsInputGemm) {
+            if((problem.MellumStage1Mode & 0x200) != 0) hf_profile_for_block = 2;
+            else if((problem.MellumStage1Mode & 0x100) != 0) {
+                const index_t kind = p_max_token_id[2 + expert_id];
+                index_t tile = 1, logical_rows = MPerBlock, depth_blocks = 0;
+                switch(kind) {
+                    case 4: tile=128; depth_blocks=1; break;
+                    case 5: tile=192; depth_blocks=1; break;
+                    case 6: tile=128; depth_blocks=2; break;
+                    case 7: tile=64; depth_blocks=2; break;
+                    case 8: tile=96; logical_rows=48; depth_blocks=2; break;
+                    case 9: tile=32; logical_rows=32; depth_blocks=2; break;
+                    case 10: tile=32; logical_rows=32; depth_blocks=4; break;
+                    case 11: tile=48; logical_rows=48; depth_blocks=4; break;
+                    case 12: tile=96; logical_rows=48; depth_blocks=2; break;
+                }
+                index_t rotation = 0;
+                if(depth_blocks != 0) rotation = (((block_m_id - p_max_token_id[66 + expert_id]) * logical_rows / tile) % 16) * depth_blocks;
+                hf_profile_for_block = kind | (rotation << 8);
+            }
+        }
+#endif
         const index_t num_k_block_main_loop = __builtin_amdgcn_readfirstlane(
             (a_grid_desc_ak0_m_ak1.GetLength(I0) * a_grid_desc_ak0_m_ak1.GetLength(I2)) /
             KPerBlock);
@@ -1894,12 +1937,7 @@ struct GridwiseMoeGemm : public GridwiseGemm_xdl_cshuffle_base<
                 c_thread_buf_up,
                 num_k_block_main_loop
 #ifdef CK_MELLUM_HF_KORDER
-                , ((problem.MellumStage1Mode & 0x200) != 0 ? 2 :
-                   ((problem.MellumStage1Mode & 0x100) != 0 ?
-                    (p_max_token_id[2 + expert_id] |
-                     ((p_max_token_id[2 + expert_id] == 4 || p_max_token_id[2 + expert_id] == 5) ?
-                       ((((block_m_id - p_max_token_id[66 + expert_id]) * MPerBlock /
-                          (p_max_token_id[2 + expert_id] == 4 ? 128 : 192)) % 16) << 8) : 0)) : 0))
+                , hf_profile_for_block
