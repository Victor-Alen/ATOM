From 705b8871b0ee4543cc1ad1850dad2420b3513313 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Thu, 5 Nov 2026 00:11:44 +0000
Subject: [PATCH 12/12] fix: preserve HF direct-division SiLU at extreme
 negative inputs

---
 include/ck/tensor_operation/gpu/grid/gridwise_moe_gemm.hpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/include/ck/tensor_operation/gpu/grid/gridwise_moe_gemm.hpp b/include/ck/tensor_operation/gpu/grid/gridwise_moe_gemm.hpp
index 09155a93a..527f68414 100644
--- a/include/ck/tensor_operation/gpu/grid/gridwise_moe_gemm.hpp
+++ b/include/ck/tensor_operation/gpu/grid/gridwise_moe_gemm.hpp
@@ -705,7 +705,9 @@ struct GridwiseMoeGemm : public GridwiseGemm_xdl_cshuffle_base<
         up = type_convert<float>(type_convert<bhalf_t>(up));
         if(mode == 2) return gate;
         if(mode == 3) return up;
-        tensor_operation::element_wise::Silu{}(gate, gate);
+        // HF divides the input directly. Computing sigmoid first can flush a
+        // subnormal reciprocal to zero before multiplication by a normal input.
+        gate = gate / (1.0f + math::exp(-gate));
         gate = type_convert<float>(type_convert<bhalf_t>(gate));
         if(mode == 4) return gate;
         return gate * up;
-- 
2.43.0

