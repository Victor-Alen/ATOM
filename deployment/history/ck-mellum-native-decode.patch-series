@@ -469,7 +469,7 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
                         const BBlockTransferStep& b_block_copy_step,
                         CThreadBuffer& c_thread_buf,
                         CThreadBuffer& c_thread_buf_up,
-                        index_t num_loop) const
+                        index_t num_loop, bool hf_mi32 = false) const
     {
         ignore = b_block_buf;
         __builtin_amdgcn_sched_barrier(0);
@@ -568,6 +568,7 @@ struct BlockwiseGemmXdlops_pipeline_bpreshuffle_gufusion_v3<BlockGemmPipelineSch
             if constexpr(is_same_v<ADataType, bhalf_t> && is_same_v<BDataType, bhalf_t> &&
                          MPerXDL == 16 && NPerXDL == 16 && KPack == 8)
             {
+                if(!hf_mi32) return;
                 auto src = vec;
                 const unsigned lane = get_thread_local_1d_id() % 64;
                 static_for<0, 4, 1>{}([&](auto pair) {
diff --git a/include/ck/tensor_operation/gpu/grid/gridwise_moe_gemm.hpp b/include/ck/tensor_operation/gpu/grid/gridwise_moe_gemm.hpp
index 5ac6ff88e..8fba15d40 100644
--- a/include/ck/tensor_operation/gpu/grid/gridwise_moe_gemm.hpp
+++ b/include/ck/tensor_operation/gpu/grid/gridwise_moe_gemm.hpp
@@ -695,6 +695,7 @@ struct GridwiseMoeGemm : public GridwiseGemm_xdl_cshuffle_base<
     // 1: HF rounding boundaries; 2/3: GEMM gate/up; 4: rounded SiLU.
     __device__ static float MellumSiluMul(float gate, float up, index_t mode)
     {
+        mode &= 0xff; // High bits carry opt-in stage1 metadata ABI flags.
         if(mode == 0)
         {
             tensor_operation::element_wise::Silu{}(gate, gate);
@@ -828,6 +829,10 @@ struct GridwiseMoeGemm : public GridwiseGemm_xdl_cshuffle_base<
                 {
                     const char* mode = std::getenv("CK_MELLUM_STAGE1_MODE");
                     this->MellumStage1Mode = mode ? std::atoi(mode) : 0;
+#ifdef CK_MELLUM_HF_KORDER
+                    const char* plan = std::getenv("CK_MELLUM_STAGE1_KORDER_PLAN");
+                    if(plan && std::atoi(plan) != 0) this->MellumStage1Mode |= 0x100;
+#endif
                 }
             }
 
