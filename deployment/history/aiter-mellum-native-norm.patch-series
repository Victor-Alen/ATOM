diff --git a/csrc/kernels/rmsnorm_quant_kernels.cu b/csrc/kernels/rmsnorm_quant_kernels.cu
index c8c0788d6..f47f31f3f 100644
--- a/csrc/kernels/rmsnorm_quant_kernels.cu
+++ b/csrc/kernels/rmsnorm_quant_kernels.cu
@@ -12,7 +12,15 @@
 
 namespace aiter {
 
-template <typename DTYPE_I, typename DTYPE_O, int BlockSize, int thread_data_size, bool ADD_RESIDUAL=true, bool FUSE_QUANT=true, bool interleave = false, int num_row = 1>
+__device__ __forceinline__ float hf_add(float a, float b) {
+    float out; asm volatile("v_add_f32 %0, %1, %2" : "=v"(out) : "v"(a), "v"(b)); return out;
+}
+__device__ __forceinline__ float hf_mul(float a, float b) {
+    float out; asm volatile("v_mul_f32 %0, %1, %2" : "=v"(out) : "v"(a), "v"(b)); return out;
+}
+
+
+template <typename DTYPE_I, typename DTYPE_O, int BlockSize, int thread_data_size, bool ADD_RESIDUAL=true, bool FUSE_QUANT=true, bool interleave = false, int num_row = 1, bool HF_ORDER = false>
 __global__ void add_rmsnorm_quant_kernel(
     DTYPE_O* out,
     DTYPE_I* residual_out,
@@ -28,8 +36,84 @@ __global__ void add_rmsnorm_quant_kernel(
     int residual_out_stride,
     int out_stride,
     int group_size,
-    bool shuffle_scale=false)
+    bool shuffle_scale=false, const int32_t* hf_row_offsets=nullptr)
     {
+        if constexpr(HF_ORDER)
+        {
+            // Match ATen Reduce.cuh per-request layout while batching requests.
+            const int begin = hf_row_offsets[blockIdx.y];
+            const int rows = hf_row_offsets[blockIdx.y + 1] - begin;
+            int width = 32;
+            if(n == 2304)
+                width = rows >= 8 ? 64 : rows >= 4 ? 128 : rows >= 2 ? 256 : 512;
+            const int rows_per_block = 512 / width;
+            const int row_base = blockIdx.x * rows_per_block;
+            if(row_base >= rows) return;
+            const int lane = threadIdx.x % width;
+            const int local_row = row_base + threadIdx.x / width;
+            const int64_t row = begin + local_row;
+            const bool valid_row = local_row < rows;
+            float acc[4] = {0.f, 0.f, 0.f, 0.f};
+            for(int col = lane * 4; col < n; col += width * 4)
+            {
+                #pragma unroll
+                for(int j = 0; j < 4; ++j)
+                {
+                    float x = valid_row ? static_cast<float>(input[row * input_stride + col + j]) : 0.f;
+                    if constexpr(ADD_RESIDUAL)
+                    {
+                        float r = valid_row ? static_cast<float>(residual_in[row * residual_in_stride + col + j]) : 0.f;
+                        x = opus::bf16_to_fp32(opus::fp32_to_bf16<0>(hf_add(x, r)));
+                    }
+                    acc[j] = hf_add(acc[j], hf_mul(x, x));
+                }
+            }
+            float total = hf_add(hf_add(hf_add(acc[0], acc[1]), acc[2]), acc[3]);
+            __shared__ float partial[512];
+            partial[threadIdx.x] = total;
+            __syncthreads();
+            for(int offset = width / 2; offset >= 64; offset /= 2)
+            {
+                if(lane < offset)
+                    partial[threadIdx.x] = hf_add(partial[threadIdx.x], partial[threadIdx.x + offset]);
+                __syncthreads();
+            }
+            total = partial[threadIdx.x];
+            const int warp_width = width < 64 ? width : 64;
+            for(int offset = 1; offset < warp_width; offset *= 2)
+                total = hf_add(total, __shfl_down(total, offset, warp_width));
+            if(lane == 0)
+            {
+                const float mean = hf_mul(total, static_cast<float>(1.0 / static_cast<double>(n)));
+                const float variance = hf_add(mean, static_cast<float>(epsilon));
+                partial[threadIdx.x] = static_cast<float>(rsqrt(static_cast<double>(variance)));
+            }
+            __syncthreads();
+            const float inverse = partial[threadIdx.x - lane];
+            if(valid_row)
+            {
+                for(int col = lane * 4; col < n; col += width * 4)
+                {
+                    #pragma unroll
+                    for(int j = 0; j < 4; ++j)
+                    {
+                        float x = static_cast<float>(input[row * input_stride + col + j]);
+                        if constexpr(ADD_RESIDUAL)
+                        {
+                            const float r = static_cast<float>(residual_in[row * residual_in_stride + col + j]);
+                            auto summed = opus::fp32_to_bf16<0>(hf_add(x, r));
+                            x = opus::bf16_to_fp32(summed);
+                            residual_out[row * residual_out_stride + col + j] = summed;
+                        }
+                        const float normalized = opus::bf16_to_fp32(opus::fp32_to_bf16<0>(hf_mul(x, inverse)));
+                        out[row * out_stride + col + j] = opus::fp32_to_bf16<0>(
+                            hf_mul(normalized, static_cast<float>(weight[col + j])));
+                    }
+                }
+            }
+            return;
+        }
+
         static constexpr int32_t load_chunk_bytes = sizeof(DTYPE_I) * thread_data_size % 16 == 0 ? 16 : 8;
         static_assert(thread_data_size * sizeof(DTYPE_I) % load_chunk_bytes == 0, "thread_data_size * sizeof(DTYPE_I) must be a multiple of load_chunk_bytes");
         static constexpr int32_t load_vec_size = load_chunk_bytes / sizeof(DTYPE_I);
@@ -508,9 +592,37 @@ __global__ void add_rmsnorm_quant_kernel(
         torch::Tensor& residual_in,
         torch::Tensor& residual_out,
         torch::Tensor& weight,
-        double epsilon
+        double epsilon,
+        std::optional<torch::Tensor> hf_row_offsets,
+        int64_t hf_max_rows
     )
     {
+
+        if(hf_row_offsets.has_value())
+        {
+            const int n = input.size(1);
+            const int m = input.size(0);
+            const auto& offsets = hf_row_offsets.value();
+            TORCH_CHECK(input.scalar_type() == torch::kBFloat16 && out.scalar_type() == torch::kBFloat16,
+                        "HF-order RMSNorm requires BF16 input and output");
+            TORCH_CHECK(n == 128 || n == 2304, "HF-order RMSNorm supports N128/N2304");
+            TORCH_CHECK(input.stride(1) == 1 && out.stride(1) == 1 && weight.is_contiguous(), "Invalid inner stride");
+            TORCH_CHECK(offsets.is_cuda() && offsets.scalar_type() == torch::kInt32 && offsets.is_contiguous()
+                        && offsets.dim() == 1 && offsets.numel() >= 2 && offsets.device() == input.device(), "Invalid request offsets");
+            TORCH_CHECK(hf_max_rows > 0 && hf_max_rows <= m, "Invalid request maximum rows");
+            const at::hip::OptionalHIPGuardMasqueradingAsCUDA device_guard(device_of(input));
+            const hipStream_t stream = at::hip::getCurrentHIPStream();
+            const int rows_per_block = n == 128 ? 16 : 8;
+            const int blocks = (hf_max_rows + rows_per_block - 1) / rows_per_block;
+            const dim3 grid(n == 2304 ? std::max(2, blocks) : blocks, offsets.numel() - 1);
+            add_rmsnorm_quant_kernel<opus::bf16_t, opus::bf16_t, 512, 16, true, false, false, 1, true>
+                <<<grid, 512, 0, stream>>>(reinterpret_cast<opus::bf16_t*>(out.data_ptr()), reinterpret_cast<opus::bf16_t*>(residual_out.data_ptr()), nullptr,
+                    reinterpret_cast<opus::bf16_t*>(input.data_ptr()), reinterpret_cast<opus::bf16_t*>(residual_in.data_ptr()),
+                    reinterpret_cast<opus::bf16_t*>(weight.data_ptr()), epsilon, m, n,
+                    input.stride(0), residual_in.stride(0), residual_out.stride(0), out.stride(0), 0, false,
+                    offsets.data_ptr<int32_t>());
+            return;
+        }
         torch::Tensor scale = torch::empty({0}, torch::TensorOptions().dtype(torch::kFloat32).device(input.device()));
 
         int n = input.size(1);
@@ -561,9 +673,37 @@ __global__ void add_rmsnorm_quant_kernel(
         torch::Tensor& out,
         torch::Tensor& input,
         torch::Tensor& weight,
-        double epsilon
+        double epsilon,
+        std::optional<torch::Tensor> hf_row_offsets,
+        int64_t hf_max_rows
     )
     {
+
+        if(hf_row_offsets.has_value())
+        {
+            const int n = input.size(1);
+            const int m = input.size(0);
+            const auto& offsets = hf_row_offsets.value();
+            TORCH_CHECK(input.scalar_type() == torch::kBFloat16 && out.scalar_type() == torch::kBFloat16,
+                        "HF-order RMSNorm requires BF16 input and output");
+            TORCH_CHECK(n == 128 || n == 2304, "HF-order RMSNorm supports N128/N2304");
+            TORCH_CHECK(input.stride(1) == 1 && out.stride(1) == 1 && weight.is_contiguous(), "Invalid inner stride");
+            TORCH_CHECK(offsets.is_cuda() && offsets.scalar_type() == torch::kInt32 && offsets.is_contiguous()
+                        && offsets.dim() == 1 && offsets.numel() >= 2 && offsets.device() == input.device(), "Invalid request offsets");
+            TORCH_CHECK(hf_max_rows > 0 && hf_max_rows <= m, "Invalid request maximum rows");
+            const at::hip::OptionalHIPGuardMasqueradingAsCUDA device_guard(device_of(input));
+            const hipStream_t stream = at::hip::getCurrentHIPStream();
+            const int rows_per_block = n == 128 ? 16 : 8;
+            const int blocks = (hf_max_rows + rows_per_block - 1) / rows_per_block;
+            const dim3 grid(n == 2304 ? std::max(2, blocks) : blocks, offsets.numel() - 1);
+            add_rmsnorm_quant_kernel<opus::bf16_t, opus::bf16_t, 512, 16, false, false, false, 1, true>
+                <<<grid, 512, 0, stream>>>(reinterpret_cast<opus::bf16_t*>(out.data_ptr()), nullptr, nullptr,
+                    reinterpret_cast<opus::bf16_t*>(input.data_ptr()), nullptr,
+                    reinterpret_cast<opus::bf16_t*>(weight.data_ptr()), epsilon, m, n,
+                    input.stride(0), 0, 0, out.stride(0), 0, false,
+                    offsets.data_ptr<int32_t>());
+            return;
+        }
         torch::Tensor scale = torch::empty({0}, torch::TensorOptions().dtype(torch::kFloat32).device(input.device()));
         torch::Tensor residual_in = torch::empty({0}, torch::TensorOptions().dtype(input.dtype()).device(input.device()));
         torch::Tensor residual_out = torch::empty({0}, torch::TensorOptions().dtype(input.dtype()).device(input.device()));
diff --git a/op_tests/test_rmsnorm_request_groups.py b/op_tests/test_rmsnorm_request_groups.py
new file mode 100644
index 000000000..402847b5f
--- /dev/null
+++ b/op_tests/test_rmsnorm_request_groups.py
@@ -0,0 +1,78 @@
+"""Exact BF16 regression for request-grouped original HIP RMSNorm.
+
+Run with the target AITER checkout on PYTHONPATH and an isolated AITER_JIT_DIR.
+"""
+
+import itertools
+import unittest
+
+import aiter
+import torch
+
+
+@unittest.skipUnless(torch.cuda.is_available(), "requires a ROCm GPU")
+class TestRequestGroupedRMSNorm(unittest.TestCase):
+    @torch.inference_mode()
+    def test_reference_rounding_and_request_shapes(self):
+        torch.manual_seed(20261104)
+        group_sets = [[n] for n in (1, 2, 3, 4, 5, 6, 7, 8, 9, 32, 990, 1024, 16384)]
+        group_sets += [[1] * 32, [1, 2, 3, 4, 7, 8, 32, 990]]
+        for width in (128, 2304):
+            for groups in group_sets:
+                for add in (False, True):
+                    with self.subTest(width=width, groups=groups, residual=add):
+                        rows = sum(groups)
+                        offsets = [0]
+                        for size in groups:
+                            offsets.append(offsets[-1] + size)
+                        gpu_offsets = torch.tensor(
+                            offsets, device="cuda", dtype=torch.int32
+                        )
+                        # Noncompact strides catch kernels assuming contiguous rows.
+                        x = torch.randn(
+                            rows, width + 16, device="cuda", dtype=torch.bfloat16
+                        )[:, :width]
+                        residual = torch.randn(
+                            rows, width + 8, device="cuda", dtype=torch.bfloat16
+                        )[:, :width]
+                        weight = torch.randn(width, device="cuda", dtype=torch.bfloat16)
+                        summed = x + residual if add else x
+                        expected = []
+                        for start, stop in itertools.pairwise(offsets):
+                            value = summed[start:stop].float()
+                            variance = value.square().mean(-1, keepdim=True)
+                            normalized = (value * torch.rsqrt(variance + 1e-6)).to(
+                                torch.bfloat16
+                            )
+                            expected.append(weight * normalized)
+                        expected = torch.cat(expected)
+                        # Poison outputs: missing tail writes must never pass via reused memory.
+                        output = torch.full(
+                            (rows, width),
+                            float("nan"),
+                            device="cuda",
+                            dtype=torch.bfloat16,
+                        )
+                        residual_output = torch.full_like(output, float("nan"))
+                        kwargs = {
+                            "hf_row_offsets": gpu_offsets,
+                            "hf_max_rows": max(groups),
+                        }
+                        if add:
+                            aiter.add_rmsnorm(
+                                output,
+                                x,
+                                residual,
+                                residual_output,
+                                weight,
+                                1e-6,
+                                **kwargs
+                            )
+                            self.assertTrue(torch.equal(residual_output, summed))
+                        else:
+                            aiter.rmsnorm(output, x, weight, 1e-6, **kwargs)
+                        self.assertTrue(torch.equal(output, expected))
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
-- 
2.43.0

