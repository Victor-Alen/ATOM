From 8ddfc7510536d61f4e1863e9cf91c495be1f8c2c Mon Sep 17 00:00:00 2001
From: Peng Sun <pengsun@amd.com>
Date: Fri, 29 May 2026 21:47:26 +0000
Subject: [PATCH 2/5] ci(release): install flydsl from AMD mirror + fix
 install_triton.sh dpkg/pipefail

- workflow: replace flydsl-drop with install from rocm.frameworks-devreleases.amd.com whl-staging
  (v0.1.15 setup.py:start_aot now imports aiter.aot.flydsl.gemm at build time)
- install_triton.sh: guard dpkg | awk pipeline with || true to survive pipefail on
  non-Debian / no-rocm-core containers (pytorch/manylinux2_28-builder)
---
 .github/scripts/install_triton.sh    |  2 +-
 .github/workflows/aiter-release.yaml | 14 ++++++--------
 2 files changed, 7 insertions(+), 9 deletions(-)

diff --git a/.github/scripts/install_triton.sh b/.github/scripts/install_triton.sh
index 6e763e943..d7fb524ff 100755
--- a/.github/scripts/install_triton.sh
+++ b/.github/scripts/install_triton.sh
@@ -30,7 +30,7 @@ install_triton_from_wheelhouse() {
 }
 
 TRITON_INDEX_URL="https://pypi.amd.com/triton/release_/rocm-7.0.0/simple/"
-ROCM_VERSION=$(dpkg -l rocm-core 2>/dev/null | awk '/^ii/{print $3}')
+ROCM_VERSION=$(dpkg -l rocm-core 2>/dev/null | awk '/^ii/{print $3}' || true)
 if [[ -n "$ROCM_VERSION" ]]; then
     ROCM_MAJOR_MINOR=$(echo "$ROCM_VERSION" | cut -d. -f1,2)
     TRITON_INDEX_URL="https://pypi.amd.com/triton/release_/rocm-${ROCM_MAJOR_MINOR}.0/simple/"
diff --git a/.github/workflows/aiter-release.yaml b/.github/workflows/aiter-release.yaml
index 09a9b9cda..0469be2ac 100644
--- a/.github/workflows/aiter-release.yaml
+++ b/.github/workflows/aiter-release.yaml
@@ -349,14 +349,12 @@ jobs:
               set -e
               ${PYBIN}/pip install --upgrade --timeout=60 --retries=10 pip
               ${PYBIN}/pip install --timeout=60 --retries=10 --index-url "${TORCH_INDEX}" "${TORCH_SPEC}"
-              # flydsl publishes only manylinux_2_35 wheels which cannot install
-              # on AlmaLinux 8 (glibc 2.28). FlyDSL AOT pre-compilation in
-              # setup.py is wrapped in try/except and is skipped gracefully when
-              # flydsl is missing, so we drop it here. The resulting wheel still
-              # contains all CK-free + Triton kernels; only the optional
-              # FlyDSL AOT cache is omitted (kernels JIT on first use).
-              grep -v "^flydsl" requirements.txt > /tmp/requirements-no-flydsl.txt
-              ${PYBIN}/pip install --timeout=60 --retries=10 -r /tmp/requirements-no-flydsl.txt
+              # flydsl 0.1.9.dev599+ ships manylinux_2_28 wheels via AMD mirror
+              # (see ROCm/FlyDSL#527 backport). Required at build time since
+              # v0.1.15 setup.py imports aiter.aot.flydsl.gemm during start_aot().
+              ${PYBIN}/pip install --timeout=60 --retries=10 \
+                --extra-index-url https://rocm.frameworks-devreleases.amd.com/whl-staging/gfx942-gfx950/ \
+                -r requirements.txt
               ${PYBIN}/pip install --timeout=60 --retries=10 "setuptools_scm<10" ninja auditwheel patchelf
             '
 
-- 
2.43.0


From 9d4907d8d48640887264559bc01f8703a360c705 Mon Sep 17 00:00:00 2001
From: Qoder <qoder@localhost>
Date: Tue, 3 Nov 2026 10:06:14 +0000
Subject: [PATCH 3/5] fix: match HF BF16 RMSNorm residual and weight rounding

---
 csrc/kernels/rmsnorm_quant_kernels.cu | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/csrc/kernels/rmsnorm_quant_kernels.cu b/csrc/kernels/rmsnorm_quant_kernels.cu
index dbc4c5c23..c8c0788d6 100644
--- a/csrc/kernels/rmsnorm_quant_kernels.cu
+++ b/csrc/kernels/rmsnorm_quant_kernels.cu
@@ -97,6 +97,12 @@ __global__ void add_rmsnorm_quant_kernel(
                 for(int i = 0; i < thread_data_size; i++)
                 {
                     thread_data_float[i] = static_cast<float>(thread_data_i[i]) + static_cast<float>(thread_data_residual_in[i]);
+                    if constexpr(std::is_same_v<DTYPE_I, opus::bf16_t> && !FUSE_QUANT)
+                    {
+                        // HF materializes the residual sum in BF16 before RMS reduction.
+                        thread_data_float[i] = opus::bf16_to_fp32(
+                            opus::fp32_to_bf16<0>(thread_data_float[i]));
+                    }
                 }
 
                 if constexpr(use_prefetch)
@@ -158,6 +164,13 @@ __global__ void add_rmsnorm_quant_kernel(
 #endif
             }
             
+            if constexpr(std::is_same_v<DTYPE_I, opus::bf16_t> && !FUSE_QUANT)
+            {
+                // HF rounds the normalized value before multiplying the BF16 weight.
+                for(int i = 0; i < thread_data_size; ++i)
+                    thread_data_float[i] = opus::bf16_to_fp32(
+                        opus::fp32_to_bf16<0>(thread_data_float[i]));
+            }
             float* thread_data_weight2 = reinterpret_cast<float*>(&thread_data_weight);
             for(int i = 0; i < thread_data_size / 2; i++)
             {
@@ -196,6 +209,14 @@ __global__ void add_rmsnorm_quant_kernel(
 #endif
             }
 
+            if constexpr(std::is_same_v<DTYPE_I, opus::bf16_t> && !FUSE_QUANT)
+            {
+                // Explicit RNE keeps nonquantized BF16 independent of Opus defaults.
+                for(int i = 0; i < thread_data_size; ++i)
+                    thread_data_float[i] = opus::bf16_to_fp32(
+                        opus::fp32_to_bf16<0>(thread_data_float[i]));
+            }
+
             if constexpr(FUSE_QUANT)
             {
                 float thread_max = 1e-10f;
-- 
