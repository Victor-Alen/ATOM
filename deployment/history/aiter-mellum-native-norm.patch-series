From 8f34513759f8a8efdb73bb609e53a3a2a773bf84 Mon Sep 17 00:00:00 2001
From: Qoder <qoder@localhost>
Date: Tue, 3 Nov 2026 11:18:14 +0000
Subject: [PATCH 4/5] fix: optionally initialize Mellum RoPE inverse
 frequencies on CPU

---
 aiter/rotary_embedding.py | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/aiter/rotary_embedding.py b/aiter/rotary_embedding.py
index 5aff6a9c1..f5dfcc79e 100644
--- a/aiter/rotary_embedding.py
+++ b/aiter/rotary_embedding.py
@@ -124,7 +124,8 @@ class RotaryEmbedding(nn.Module):
         inv_freq = 1.0 / (
             base
             ** (
-                torch.arange(0, self.rotary_dim, 2, dtype=dtypes.fp32) / self.rotary_dim
+                torch.arange(0, self.rotary_dim, 2, dtype=dtypes.fp32,
+                    device="cpu" if os.getenv("AITER_MELLUM_HF_ROPE_INV_FREQ")=="1" else None) / self.rotary_dim
             )
         )
         return inv_freq
@@ -134,7 +135,7 @@ class RotaryEmbedding(nn.Module):
         inv_freq = self._compute_inv_freq(self.base)
         t = torch.arange(self.max_position_embeddings, dtype=dtypes.fp32)
 
-        freqs = torch.einsum("i,j -> ij", t, inv_freq)
+        freqs = torch.einsum("i,j -> ij", t, inv_freq.to(t.device))
         cos = freqs.cos().unsqueeze(-2).unsqueeze(-2)
         sin = freqs.sin().unsqueeze(-2).unsqueeze(-2)
         return cos, sin
-- 
2.43.0


