diff --git a/op_tests/mellum_hf_attention.md b/op_tests/mellum_hf_attention.md
new file mode 100644
index 000000000..97e8fbed2
--- /dev/null
+++ b/op_tests/mellum_hf_attention.md
@@ -0,0 +1,34 @@
+# Mellum HF-order paged decode (gfx942)
+
+This opt-in mode extends the existing Gluon paged-attention kernel. The default
+mode remains unchanged. It retains paged K/V and batches requests on the GPU.
+
+For the validated Torch/ROCm build in the configuration, set:
+
+```bash
+export AITER_MELLUM_HF_ATTN_MODE=10
+export AITER_MELLUM_QK_PROFILE="$PWD/aiter/configs/mellum_hf_attention_gfx942.json"
+python op_tests/test_mellum_hf_paged_attention.py
+```
+
+The profile checks the Torch version and GPU architecture. It covers query
+head dimension 128, 32 query heads, 4 KV heads, BF16, and single-token decode.
+It selects MFMA accumulation order, not alternate model/reference outputs.
+Modes 1–9 and the QK/PV width controls are diagnostic ablations; the validated
+configuration uses mode 10 with the QK profile and default width controls.
+
+The implementation preserves BF16 score/scaling/probability boundaries, ATen
+softmax reduction order, coalesced PV GlobalSplitU, PV tail MFMA order, and
+shape-dependent QK LocalSplitU. Logical window offsets and SHUFFLE V-cache
+layout must be supplied correctly by the caller. `_MELLUM_ATTN_DEBUG` exposes
+intermediate tensors only for fixed-input diagnostics; it is unset in service.
+
+Validation on the target single GPU: 18 portable cases, the 1–1024 QK-length
+profile across 9 input sets, captured real model failures, A32/C4 token checks,
+full C200 (12800/12800 tokens), and a 16384-token input (64/64 outputs). These
+operator/model checks do not establish final HumanEval or overall Step0
+acceptance. Model-level final validation remains separate.
+
+The current service integration applies this mode to decode. Prefill still
+uses its existing correctness path. Performance work and final combined
+validation are ongoing; exceeding the performance baseline is not claimed.
\ No newline at end of file
diff --git a/op_tests/test_mellum_hf_paged_attention.py b/op_tests/test_mellum_hf_paged_attention.py
new file mode 100644
index 000000000..167558a66
--- /dev/null
+++ b/op_tests/test_mellum_hf_paged_attention.py
@@ -0,0 +1,72 @@
+"""Check original paged Gluon HF mode against independent BF16 PyTorch attention.
+
+Run on the validated gfx942/Torch build with AITER imported from this checkout.
+This is an operator regression test, not a model Step0 or performance result.
+"""
+import json
+import os
+from pathlib import Path
+
+import torch
+import aiter
+
+
+def reference(q, kc, vc, table, length, window, shuffle):
+    batch, heads, dim = q.shape
+    first = max(0, length - window) if window > 0 else 0
+    count = length - first
+    results = []
+    for b in range(batch):
+        blocks = table[b].long()
+        key = kc.index_select(0, blocks).permute(0, 3, 1, 2, 4).reshape(-1, 4, dim)[first:length]
+        value = vc.index_select(0, blocks)
+        if shuffle:
+            value = value.view(len(blocks), 4, 2, dim, 8).permute(0, 2, 4, 1, 3).reshape(-1, 4, dim)
+        else:
+            value = value.permute(0, 3, 1, 2).reshape(-1, 4, dim)
+        value = value[first:length]
+        key = key.transpose(0, 1)[None, :, None].expand(1, 4, 8, count, dim).reshape(1, heads, count, dim)
+        value = value.transpose(0, 1)[None, :, None].expand(1, 4, 8, count, dim).reshape(1, heads, count, dim)
+        scores = (q[b:b + 1, :, None, :] @ key.transpose(2, 3)) * (dim ** -0.5)
+        probabilities = torch.softmax(scores, -1, dtype=torch.float32).to(torch.bfloat16)
+        results.append((probabilities @ value).reshape(1, heads, dim))
+    return torch.cat(results)
+
+
+def test_native_mellum_attention():
+    config = Path(__file__).resolve().parents[1] / 'aiter/configs/mellum_hf_attention_gfx942.json'
+    os.environ['AITER_MELLUM_HF_ATTN_MODE'] = '10'
+    os.environ['AITER_MELLUM_QK_PROFILE'] = str(config)
+    for name in ['AITER_MELLUM_QK_K_WIDTH', 'AITER_MELLUM_QK_SPLIT', 'AITER_MELLUM_PV_K_WIDTH']:
+        os.environ.pop(name, None)
+    cases = [(1,127,1024,False), (4,257,1024,False), (4,1025,1024,False),
+             (1,2049,0,False), (1,12588,0,True), (4,4097,0,True)]
+    failures = []
+    with torch.inference_mode():
+        for seed, scale in enumerate([1.0, 0.17, 3.3]):
+            torch.manual_seed(20261111 + seed)
+            for batch, length, window, shuffle in cases:
+                slots = (length + 15) // 16
+                blocks = batch * slots
+                kc = (torch.randn(blocks,4,16,16,8,device='cuda') * scale).to(torch.bfloat16)
+                vc = torch.randn(blocks,4,128,16,device='cuda',dtype=torch.bfloat16)
+                q = (torch.randn(batch,32,128,device='cuda') * scale).to(torch.bfloat16)
+                table = torch.randperm(blocks,device='cuda',dtype=torch.int32).reshape(batch,slots)
+                lengths = torch.full((batch,),length,device='cuda',dtype=torch.int32)
+                out = torch.full_like(q,float('nan'))
+                native_v = vc.view(blocks,4,2,128,8) if shuffle else vc
+                aiter.pa_decode_gluon(out,q,kc,native_v,lengths,table,128**-0.5,1,1,128,
+                                     torch.bfloat16,sliding_window=window,ps=True)
+                expected = reference(q,kc,vc,table,length,window,shuffle)
+                mismatch = int((out != expected).sum())
+                row = dict(seed=seed,batch=batch,length=length,window=window,
+                           shuffle=shuffle,mismatches=mismatch,elements=out.numel())
+                print(json.dumps(row),flush=True)
+                if mismatch:
+                    failures.append(row)
+    assert not failures, failures
+
+
+if __name__ == '__main__':
+    test_native_mellum_attention()
+    print('ALL_18_CASES_EXACT',flush=True)
\ No newline at end of file
-- 
