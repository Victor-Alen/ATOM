From 269546baff9c6350a9f93ea954c16404bd009fd5 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Thu, 5 Nov 2026 04:32:00 +0000
Subject: [PATCH 8/8] Add opt-in HF-order staged full decode attention with
 reusable GPU workspace

---
 aiter/ops/triton/gluon/pa_decode_gluon.py | 256 ++++++++++++++++------
 1 file changed, 185 insertions(+), 71 deletions(-)

diff --git a/aiter/ops/triton/gluon/pa_decode_gluon.py b/aiter/ops/triton/gluon/pa_decode_gluon.py
index 2110e92e4..1fbc72370 100644
--- a/aiter/ops/triton/gluon/pa_decode_gluon.py
+++ b/aiter/ops/triton/gluon/pa_decode_gluon.py
@@ -2205,6 +2205,78 @@ def _mellum_hf_large_sum(acc, e, base, n, heads, lanes, BLOCK: gl.constexpr):
     return acc
 
 
+@lru_cache(maxsize=32)
+def _mellum_gmem_workspace(device, seqs, heads, capacity):
+    shape = (seqs, heads, capacity)
+    return (torch.empty(shape, device=torch.device('cuda', device), dtype=torch.bfloat16),
+            torch.empty(shape, device=torch.device('cuda', device), dtype=torch.bfloat16))
+
+
+@gluon.jit
+def _mellum_gmem_softmax(scores, probs, lengths, CAPACITY):
+    seq = gl.program_id(0)
+    head = gl.program_id(1)
+    n = gl.load(lengths + seq)
+    offset = (seq * 32 + head).to(gl.int64) * CAPACITY
+    if n <= 2048:
+        lanes = gl.arange(0, 64, layout=gl.BlockedLayout([1], [64], [8], [0]))
+        local_max = gl.full([64], float('-inf'), gl.float32, gl.BlockedLayout([1], [64], [8], [0]))
+        for block in range(gl.cdiv(n, 64)):
+            pos = block * 64 + lanes
+            x = gl.load(scores + offset + pos, pos < n, other=float('-inf')).to(gl.float32)
+            local_max = gl.maximum(local_max, x)
+        mx = gl.max(local_max, 0)
+        acc = gl.full([64], 0.0, gl.float32, gl.BlockedLayout([1], [64], [8], [0]))
+        for block in range(gl.cdiv(n, 64)):
+            pos = block * 64 + lanes
+            x = gl.load(scores + offset + pos, pos < n, other=float('-inf')).to(gl.float32)
+            acc += hip_libdevice.exp(x - mx)
+        for step in gl.static_range(6):
+            acc += gl.gather(acc, lanes ^ (32 >> step), 0)
+        denom = gl.sum(gl.where(lanes == 0, acc, 0.0), 0)
+        for block in range(gl.cdiv(n, 64)):
+            pos = block * 64 + lanes
+            x = gl.load(scores + offset + pos, pos < n, other=float('-inf')).to(gl.float32)
+            p = gl.div_rn(hip_libdevice.exp(x - mx), denom)
+            gl.store(probs + offset + pos, p.to(gl.bfloat16), pos < n)
+    else:
+        large_lanes = gl.arange(0, 512, layout=gl.BlockedLayout([1], [64], [8], [0]))
+        large_local_max = gl.full([512], float('-inf'), gl.float32, gl.BlockedLayout([1], [64], [8], [0]))
+        for large_block in range(gl.cdiv(n, 512)):
+            large_pos = large_block * 512 + large_lanes
+            large_x = gl.load(scores + offset + large_pos, large_pos < n, other=float('-inf')).to(gl.float32)
+            large_local_max = gl.maximum(large_local_max, large_x)
+        large_mx = gl.max(large_local_max, 0)
+        large_shift = (head * n) % 4
+        large_start = gl.where(large_shift > 0, 512 - large_shift, 0)
+        large_bulk = gl.where(n % 4 == 0, gl.cdiv(n, 2048) * 2048, ((n - large_start) // 2048) * 2048)
+        large_prefix = large_lanes - large_shift
+        large_x = gl.load(scores + offset + large_prefix, (large_shift > 0) & (large_prefix >= 0) & (large_prefix < n), other=float('-inf')).to(gl.float32)
+        large_acc = tl.exp(large_x - large_mx)
+        for large_block in range(gl.cdiv(n, 2048)):
+            for large_j in gl.static_range(4):
+                large_pos = large_start + large_block * 2048 + large_lanes * 4 + large_j
+                large_x = gl.load(scores + offset + large_pos, (large_block * 2048 < large_bulk) & (large_pos < n), other=float('-inf')).to(gl.float32)
+                large_acc += tl.exp(large_x - large_mx)
+        for large_j in gl.static_range(4):
+            large_pos = large_start + large_bulk + large_lanes + large_j * 512
+            large_x = gl.load(scores + offset + large_pos, large_pos < n, other=float('-inf')).to(gl.float32)
+            large_acc += tl.exp(large_x - large_mx)
+        for large_step in gl.static_range(6):
+            large_src = large_lanes // 64 * 64 + gl.minimum(large_lanes % 64 + (32 >> large_step), 63)
+            large_acc += gl.gather(large_acc, large_src, 0)
+        large_warp_sums = gl.gather(large_acc, gl.minimum(large_lanes, 7) * 64, 0)
+        large_warp_sums = gl.where(large_lanes < 8, large_warp_sums, 0.0)
+        for large_step in gl.static_range(6):
+            large_warp_sums += gl.gather(large_warp_sums, gl.minimum(large_lanes + (32 >> large_step), 63), 0)
+        large_denom = gl.sum(gl.where(large_lanes == 0, large_warp_sums, 0.0), 0)
+        large_inv = gl.div_rn(1.0, large_denom)
+        for large_block in range(gl.cdiv(n, 512)):
+            large_pos = large_block * 512 + large_lanes
+            large_x = gl.load(scores + offset + large_pos, large_pos < n, other=float('-inf')).to(gl.float32)
+            gl.store(probs + offset + large_pos, (tl.exp(large_x - large_mx) * large_inv).to(gl.bfloat16), large_pos < n)
+
+
 @gluon.jit
 def _mellum_concat_columns(a, b):
     joined = gl.join(a, b)
@@ -2273,6 +2345,9 @@ def paged_attention_decode_sliding_window(
     HF_BF16_MODE: gl.constexpr = 0,
     HF_HEAD_SPLITS: gl.constexpr = 1,
     HF_LDS_WINDOW: gl.constexpr = False,
+    HF_CACHE_STAGE: gl.constexpr = 0,
+    hf_cache_ptr=None,
+    HF_CACHE_N = 0,
     hf_qk_ptr=None,
     hf_scores_ptr=None,
     hf_probs_ptr=None,
@@ -2790,7 +2865,7 @@ def paged_attention_decode_sliding_window(
 
     query_shared.store(mtp_query_tensor)
 
-    HF_PV_PASS: gl.constexpr = 1 if HF_LDS_WINDOW else (2 if HF_BF16_MODE >= 5 else 1)
+    HF_PV_PASS: gl.constexpr = (99 if HF_CACHE_STAGE == 1 else 0) if HF_CACHE_STAGE != 0 else (1 if HF_LDS_WINDOW else (2 if HF_BF16_MODE >= 5 else 1))
     hf_softmax_layout: gl.constexpr = gl.BlockedLayout([1, 1], [1, 64], [4, 1], [1, 0])
     hf_cols = gl.arange(0, 64, layout=gl.SliceLayout(0, hf_softmax_layout))
     hf_rows = gl.arange(0, QUERY_GROUP_SIZE_POW2, layout=gl.SliceLayout(1, hf_softmax_layout))
@@ -2827,7 +2902,7 @@ def paged_attention_decode_sliding_window(
     initial_kv_block_numbers = kv_block_numbers
     if HF_BF16_MODE >= 3:
         gl.static_assert(sinks_ptr is None)
-    for hf_pass in gl.static_range(2 if HF_LDS_WINDOW else (3 if HF_BF16_MODE >= 5 else (2 if HF_BF16_MODE >= 3 else 1))):
+    for hf_pass in gl.static_range(1 if HF_CACHE_STAGE != 0 else (2 if HF_LDS_WINDOW else (3 if HF_BF16_MODE >= 5 else (2 if HF_BF16_MODE >= 3 else 1)))):
         kv_block_start_idx = initial_kv_block_start_idx
         kv_block_numbers = initial_kv_block_numbers
         page_offset = (
@@ -3148,7 +3223,19 @@ def paged_attention_decode_sliding_window(
             if hf_scores_ptr is not None and hf_pass == 0:
                 gl.store(hf_scores_ptr + hf_debug_offsets, attention_scores, hf_debug_mask)
             # ==================== SOFTMAX COMPUTATION ====================
-            if HF_LDS_WINDOW:
+            if HF_CACHE_STAGE != 0:
+                gl.static_assert(HF_BF16_MODE == 10 and SLIDING_WINDOW <= 0 and HF_HEAD_SPLITS == 1)
+                hf_cache_heads = kv_head_idx * query_group_size + qk_row_offsets
+                hf_cache_offsets = (sequence_idx.to(gl.int64) * 32 + hf_cache_heads[:, None]) * HF_CACHE_N + qk_column_offsets[None, :]
+                hf_cache_mask = qk_row_mask[:, None] & (qk_column_offsets[None, :] < context_length)
+                accumulator_scale = gl.full((QUERY_GROUP_SIZE_POW2,), 1.0, gl.float32, gl.SliceLayout(1, qk_linear_layout))
+                new_max_logits = max_logits
+                if HF_CACHE_STAGE == 1:
+                    gl.store(hf_cache_ptr + hf_cache_offsets, attention_scores.to(gl.bfloat16), hf_cache_mask)
+                    attention_probs = attention_scores * 0.0
+                else:
+                    attention_probs = gl.load(hf_cache_ptr + hf_cache_offsets, hf_cache_mask, other=0.0).to(gl.float32)
+            elif HF_LDS_WINDOW:
                 accumulator_scale = max_logits * 0.0 + 1.0
                 if hf_pass == 0:
                     new_max_logits = gl.maximum(max_logits, gl.max(attention_scores, axis=1))
@@ -3344,6 +3431,9 @@ def paged_attention_decode_sliding_window(
                 hf_denominator = gl.sum(gl.where(hf_cols[None, :] == 0, hf_lane_sums, 0.0), axis=1)
             exp_sums = gl.convert_layout(hf_denominator, gl.SliceLayout(1, qk_linear_layout))
 
+    if HF_CACHE_STAGE == 1:
+        return
+
     # ==================== SINKS HANDLING ====================
     # Add sinks contribution to exp_sums (does not contribute to attention output)
     if ONE_SHOT and sinks_ptr is not None:
@@ -4658,74 +4748,98 @@ def _paged_attention_decode_v2_with_dot_kernel_reshape_wrapper(
                 QUERY_SEQ_LEN_POW2 = triton.cdiv(QUERY_SEQ_LEN_POW2, mtp_splits)
         else:
             paged_attention_kernel = paged_attention_decode_sliding_window
-        paged_attention_kernel[grid](
