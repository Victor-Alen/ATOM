diff --git a/aiter/ops/triton/gluon/pa_decode_gluon.py b/aiter/ops/triton/gluon/pa_decode_gluon.py
index 915bd14fb..3c4fb1af6 100644
--- a/aiter/ops/triton/gluon/pa_decode_gluon.py
+++ b/aiter/ops/triton/gluon/pa_decode_gluon.py
@@ -11,6 +11,21 @@ import triton
 import triton.language as tl
 from triton.language.extra.hip import libdevice as hip_libdevice
 
+_MELLUM_ATTN_DEBUG = None
+
+@lru_cache(maxsize=8)
+def _mellum_qk_profile_tensor(path, device):
+    if not path:
+        return None
+    import json
+    from pathlib import Path
+    profile = json.loads(Path(path).read_text())
+    assert profile['torch'] == torch.__version__
+    assert profile['arch'] == torch.cuda.get_device_properties(device).gcnArchName
+    assert len(profile['classes']) == 1025
+    return torch.tensor(profile['classes'], device=torch.device('cuda', device), dtype=torch.int32)
+
+
 CXX_PS_REDUCE_AVAILABLE = True
 try:
     from csrc.cpp_itfs.pa.pa_ps import (
@@ -2163,6 +2178,33 @@ def paged_attention_decode_sliding_window_head_1(
 #     ],
 #     cache_results=True,
 # )
+@gluon.jit
+def _mellum_hf_take_exp(e, index, valid, BLOCK: gl.constexpr):
+    sampled = gl.gather(e, gl.minimum(gl.maximum(index, 0), BLOCK - 1), axis=1)
+    return gl.where(valid & (index >= 0) & (index < BLOCK), sampled, 0.0)
+
+
+@gluon.jit
+def _mellum_hf_large_sum(acc, e, base, n, heads, lanes, BLOCK: gl.constexpr):
+    # Installed ATen SoftMax.cu: alignment prefix, vector-four bulk, scalar tail.
+    shift = (heads * n) % 4
+    start = gl.where(shift > 0, 512 - shift, 0)
+    bulk = gl.where(n % 4 == 0, gl.cdiv(n, 2048) * 2048, ((n - start) // 2048) * 2048)
+    prefix = lanes[None, :] - shift[:, None]
+    acc += _mellum_hf_take_exp(e, prefix - base, (shift[:, None] > 0) & (prefix >= 0) & (prefix < n), BLOCK)
