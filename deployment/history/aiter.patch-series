+            hf_save_cols = gl.arange(0, 128, layout=gl.SliceLayout(0, hf_softmax_layout))
+            for hf_save in gl.static_range(8):
+                hf_save_idx = hf_rows[:, None] * 0 + hf_save_cols[None, :] + hf_save * 128
+                hf_window_shared.index(hf_save).store(gl.gather(hf_full_probs, hf_save_idx, axis=1))
+        if not HF_LDS_WINDOW and HF_BF16_MODE >= 5 and hf_pass == 1:
             if HF_BF16_MODE >= 8 and SLIDING_WINDOW <= 0 and hf_window_length > 2048:
                 for hf_shift in gl.static_range(6):
                     source = hf_large_cols // 64 * 64 + gl.minimum(hf_large_cols % 64 + (32 >> hf_shift), 63)
@@ -4584,6 +4630,20 @@ def _paged_attention_decode_v2_with_dot_kernel_reshape_wrapper(
         hf_bf16_mode = int(__import__("os").environ.get("AITER_MELLUM_HF_ATTN_MODE", "0"))
         if 5 <= hf_bf16_mode < 8 and SLIDING_WINDOW <= 0:
             hf_bf16_mode = 3  # Full attention needs ATen's large-row reduction next.
+        hf_lds_window = __import__("os").environ.get("AITER_MELLUM_HF_LDS_WINDOW") == "1" and SLIDING_WINDOW == 1024
+        if hf_lds_window:
+            if not (hf_bf16_mode == 10 and ONE_SHOT and query_seq_len == 1 and num_kv_heads == 4 and query_group_size == 8 and QUERY_QUANT_MODE < 0 and KV_QUANT_MODE < 0):
+                raise ValueError("LDS window requires BF16 Mellum single-query mode10")
+            CONTEXT_PARTITION_SIZE = 128
+        hf_head_splits = int(__import__("os").environ.get("AITER_MELLUM_HF_HEAD_SPLITS", "1")) if hf_bf16_mode == 10 else 1
+        if hf_head_splits not in (1, 2):
+            raise ValueError("HF head splits currently supports only 1 or 2")
+        if hf_head_splits != 1:
+            if not (ONE_SHOT and query_seq_len == 1 and query_group_size == 8 and num_kv_heads == 4 and QUERY_QUANT_MODE < 0 and KV_QUANT_MODE < 0):
+                raise ValueError("HF head splits requires BF16 Mellum decode, 4 KV heads, GQA=8, and one-shot mode")
+            query_group_size //= hf_head_splits
+            ONE_QUERY_GROUP_SIZE_POW2 //= hf_head_splits
+            grid = (num_sequences, num_kv_heads * hf_head_splits, num_splits)
         if num_kv_heads == 1:
             paged_attention_kernel = paged_attention_decode_sliding_window_head_1
             if ONE_QUERY_GROUP_SIZE_POW2 >= 16:
@@ -4656,6 +4716,8 @@ def _paged_attention_decode_v2_with_dot_kernel_reshape_wrapper(
             CDNA_VERSION=CDNA_VERSION,
             ONE_SHOT=ONE_SHOT,
             **({"HF_BF16_MODE": hf_bf16_mode,
+                "HF_HEAD_SPLITS": hf_head_splits,
