+    // Mellum BF16 diagnostic/alignment epilogue. Mode 0 preserves CK.
+    // 1: HF rounding boundaries; 2/3: GEMM gate/up; 4: rounded SiLU.
+    __device__ static float MellumSiluMul(float gate, float up, index_t mode)
+    {
+        if(mode == 0)
+        {
+            tensor_operation::element_wise::Silu{}(gate, gate);
+            return gate * up;
+        }
+        gate = type_convert<float>(type_convert<bhalf_t>(gate));
+        up = type_convert<float>(type_convert<bhalf_t>(up));
+        if(mode == 2) return gate;
+        if(mode == 3) return up;
+        tensor_operation::element_wise::Silu{}(gate, gate);
+        gate = type_convert<float>(type_convert<bhalf_t>(gate));
+        if(mode == 4) return gate;
+        return gate * up;
+    }
